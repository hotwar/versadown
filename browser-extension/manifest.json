{
  "manifest_version": 3,
  "name": "__MSG_addonName__",
  "description": "__MSG_addonDescription__",
  "version": "0.3.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://*.x.com/*",
    "https://platform.twitter.com/embed/Tweet.html*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.hdslb.com/*",
    "https://*.googlevideo.com/*",
    "https://video.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*",
        "https://*.x.com/*",
        "https://platform.twitter.com/embed/Tweet.html*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-media-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*",
        "https://*.x.com/*",
        "https://platform.twitter.com/embed/Tweet.html*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "detection-scope.js",
        "site-media.js",
        "media.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "__MSG_addonName__",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
